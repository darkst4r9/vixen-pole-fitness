---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Vixen Pole Fitness | Pole Fitness for All Bodies",
  description = "A welcoming, non-judgmental pole fitness studio for all levels in Murrieta, CA.",
  image = "/images/gallery/gallery-6.jpeg",
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(image, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Vixen Pole Fitness",
  "url": "https://vixenpolefitness.com",
  "email": "VXN.polefitness@gmail.com",
  "image": "https://vixenpolefitness.com/images/brand/logo.png",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "24831 Jefferson Ave Ste. 104",
    "addressLocality": "Murrieta",
    "addressRegion": "CA",
    "postalCode": "92562",
    "addressCountry": "US"
  },
  "sameAs": ["https://instagram.com/vixen_pole_fitness_"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vixen Pole Fitness" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- LocalBusiness JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/brand/logo.png" />

    <!-- Inter from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-brand-white text-brand-black antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

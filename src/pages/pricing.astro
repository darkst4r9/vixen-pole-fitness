---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pricing } from "../data/content.ts";

const tiers = [
  {
    name: "Drop-In",
    price: pricing.dropIn,
    unit: "per class",
    description: "Try a class with no commitment. Reserve via Instagram DM.",
    features: ["One class", "Any class type", "No expiration"],
    highlight: false,
  },
  {
    name: "4-Class Pack",
    price: pricing.fourClassPack,
    unit: "pack",
    description: "Great for getting started. Use across any class types.",
    features: ["4 classes", "Any class type", `Expires in ${pricing.packExpiry}`],
    highlight: false,
  },
  {
    name: "8-Class Pack",
    price: pricing.eightClassPack,
    unit: "pack",
    description: "The most popular option. Best value for students attending 2x per week.",
    features: ["8 classes", "Any class type", `Expires in ${pricing.packExpiry}`, `$${Math.round(pricing.eightClassPack / 8)}/class`],
    highlight: true,
  },
  {
    name: "Unlimited Monthly",
    price: pricing.unlimitedMonthly,
    unit: "per month",
    description: "For students who are all in. Attend as many classes as you want.",
    features: ["Unlimited classes", "Any class type", "Month-to-month"],
    highlight: false,
  },
  {
    name: "6-Month Contract",
    price: pricing.sixMonthContract,
    unit: "6 months",
    description: "Best monthly rate available. Commitment to your practice.",
    features: ["Unlimited classes", "Any class type", `$${Math.round(pricing.sixMonthContract / 6)}/month`, "Best rate"],
    highlight: false,
  },
];
---

<BaseLayout
  title="Pricing | Vixen Pole Fitness"
  description="Vixen Pole Fitness class pricing in Murrieta, CA. Drop-in classes, class packs, and unlimited monthly memberships. Find the option that fits your practice."
>
  <!-- Hero -->
  <section class="bg-brand-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <p class="text-brand-mint text-xs font-semibold uppercase tracking-[0.2em] mb-6">Simple Pricing</p>
      <h1 class="font-display font-bold text-brand-white leading-none mb-6 text-[clamp(3rem,8vw,6rem)]">
        Find Your<br>Fit.
      </h1>
      <p class="text-gray-400 text-lg leading-relaxed max-w-xl">
        No hidden fees, no fine print. Pick the option that works for where you are in your practice.
      </p>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="bg-brand-black py-20 lg:py-28 border-t border-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tiers.map((tier) => (
          <div class={`relative rounded-xl p-8 flex flex-col border transition-colors duration-200 ${
            tier.highlight
              ? "bg-brand-mint border-brand-mint"
              : "bg-gray-950 border-gray-800 hover:border-brand-mint"
          }`}>
            {tier.highlight && (
              <div class="absolute -top-3 left-8">
                <span class="bg-brand-black text-brand-mint text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
                  Most Popular
                </span>
              </div>
            )}
            <div class="mb-6">
              <h3 class={`font-bold text-xl mb-1 ${tier.highlight ? "text-brand-black" : "text-brand-white"}`}>
                {tier.name}
              </h3>
              <div class="flex items-end gap-2 mt-3 mb-4">
                <span class={`font-display font-bold text-5xl leading-none ${tier.highlight ? "text-brand-black" : "text-brand-white"}`}>
                  ${tier.price}
                </span>
                <span class={`text-sm mb-1 ${tier.highlight ? "text-gray-700" : "text-gray-500"}`}>
                  {tier.unit}
                </span>
              </div>
              <p class={`text-sm leading-relaxed ${tier.highlight ? "text-gray-700" : "text-gray-400"}`}>
                {tier.description}
              </p>
            </div>
            <ul class="space-y-2 mb-8 flex-1">
              {tier.features.map((feature) => (
                <li class="flex items-center gap-2">
                  <span class={`text-sm font-medium ${tier.highlight ? "text-brand-black" : "text-gray-300"}`}>
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <a
              href="/classes#book"
              class={`block text-center px-6 py-3 rounded-lg text-sm font-semibold transition-colors ${
                tier.highlight
                  ? "bg-brand-black text-brand-white hover:bg-gray-900"
                  : "border border-brand-mint text-brand-mint hover:bg-brand-mint hover:text-brand-black"
              }`}
            >
              Get Started
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cancellation policy + FAQ -->
  <section class="bg-brand-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="font-display font-bold text-brand-black text-3xl mb-6">Cancellation Policy</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Cancel at least <strong>4 hours before your class</strong> to retain your class credit. Late cancellations and no-shows forfeit the class credit.
          </p>
          <p class="text-gray-600 leading-relaxed">
            To cancel: log in to your TeamUp account or DM us on Instagram at least 4 hours in advance.
          </p>
        </div>
        <div>
          <h2 class="font-display font-bold text-brand-black text-3xl mb-6">Questions</h2>
          <div class="space-y-5">
            <div>
              <p class="font-semibold text-brand-black mb-1">Do class packs expire?</p>
              <p class="text-gray-600 text-sm leading-relaxed">Yes. 4-class and 8-class packs expire 60 days from the date of purchase.</p>
            </div>
            <div>
              <p class="font-semibold text-brand-black mb-1">Can I try a class before committing to a pack?</p>
              <p class="text-gray-600 text-sm leading-relaxed">Yes. Drop in for $30. DM us on Instagram to reserve your spot.</p>
            </div>
            <div>
              <p class="font-semibold text-brand-black mb-1">Can I use my pack on any class type?</p>
              <p class="text-gray-600 text-sm leading-relaxed">Yes. Packs and monthly memberships work across all class types.</p>
            </div>
            <div>
              <p class="font-semibold text-brand-black mb-1">Still have questions?</p>
              <p class="text-gray-600 text-sm leading-relaxed">
                <a href="/contact" class="text-brand-black font-semibold underline underline-offset-2 hover:no-underline">Send us a message</a> or DM on Instagram.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-mint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24 text-center">
      <h2 class="font-display font-bold text-brand-black text-4xl lg:text-5xl leading-tight mb-6">
        Ready to start?
      </h2>
      <p class="text-gray-700 text-lg mb-8">Your first class is the hardest part. We make the rest easy.</p>
      <a
        href="/classes#book"
        class="inline-flex items-center px-8 py-4 bg-brand-black text-brand-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors"
      >
        Book a Class
      </a>
    </div>
  </section>
</BaseLayout>

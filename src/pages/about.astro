---
import BaseLayout from "../layouts/BaseLayout.astro";
import { instructors } from "../data/instructors.ts";

const owners = instructors.filter((i) => i.isOwner);

const values = [
  {
    heading: "Inclusion",
    body: "No judgment. No prerequisites. Just movement.",
  },
  {
    heading: "Community",
    body: "Our students become each other's biggest fans.",
  },
  {
    heading: "Empowerment",
    body: "We're here to help you unlock confidence you didn't know you had.",
  },
];
---

<BaseLayout
  title="About | Vixen Pole Fitness"
  description="Learn about Vixen Pole Fitness, our co-owners Lexi and Sarah, and our mission to make pole fitness welcoming for all bodies and levels."
>
  <!-- Hero -->
  <section class="relative bg-brand-black overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/gallery/gallery-7.jpeg" alt="" aria-hidden="true" class="w-full h-full object-contain object-right opacity-25" />
      <div class="absolute inset-0" style="background: linear-gradient(to right, #1A1A1A 50%, transparent 90%)"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <p class="text-brand-mint text-xs font-semibold uppercase tracking-[0.2em] mb-6">Our Story</p>
      <h1 class="font-display font-bold text-brand-white leading-none mb-6 text-[clamp(3rem,8vw,6rem)]">
        About Vixen
      </h1>
      <p class="text-gray-400 text-lg leading-relaxed max-w-xl">
        A studio built on inclusion, empowerment, and the belief that pole is for everybody.
      </p>
    </div>
  </section>

  <!-- Studio story -->
  <section class="bg-brand-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-brand-black text-3xl lg:text-4xl mb-6">Our Story</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            We are so excited to offer our community a pole studio where you feel like you belong — because you do! We have worked hard to bring you a clean and safe space to pole.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            We are an inclusive pole studio and have a wide range of classes for you all to try! All skill levels are welcome from your first class to looking to broaden your skills and experience!
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            We can't wait to help you gain strength, flexibility and confidence through our tricks, choreo, stretching and yoga classes!
          </p>
          <p class="text-gray-500 text-sm italic">xoxo, Lexi &amp; Sarah, co-owners</p>
        </div>
        <div class="w-full h-64 lg:h-80 rounded-xl overflow-hidden">
          <img
            src="/images/gallery/studio-featured.jpg"
            alt="Vixen Pole Fitness studio"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the founders — photo cards linking to /instructors -->
  <section class="bg-brand-black py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <h2 class="font-display font-bold text-brand-white text-4xl lg:text-5xl leading-none">The Founders</h2>
        <a href="/instructors" class="text-sm font-semibold text-gray-400 hover:text-brand-mint transition-colors">
          Meet the Full Team →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {owners.map((owner) => (
          <a
            href="/instructors"
            class="group relative rounded-xl overflow-hidden aspect-[3/4] md:aspect-[4/3] flex items-end"
          >
            <img
              src={owner.photo}
              alt={owner.name}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              style={`object-position: ${owner.photoPosition}`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="relative z-10 p-8">
              <div class="h-px bg-brand-mint w-8 mb-4 group-hover:w-16 transition-all duration-300"></div>
              <h3 class="font-display font-bold text-brand-white text-2xl mb-1">{owner.name}</h3>
              <p class="text-brand-mint text-xs font-bold uppercase tracking-wider">{owner.role}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo grid -->
  <section class="bg-brand-black py-16 lg:py-20 border-t border-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-1.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-2.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-3.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-4.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-5.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-6.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/gallery-7.jpeg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/action-1.jpg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/action-2.jpg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
        <div class="aspect-square overflow-hidden rounded-lg"><img src="/images/gallery/action-3.jpg" alt="Vixen Pole Fitness" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" /></div>
      </div>
    </div>
  </section>

  <!-- Studio values -->
  <section class="bg-brand-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <h2 class="font-display font-bold text-brand-black text-3xl lg:text-4xl mb-10">What We Stand For</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="bg-brand-white rounded-xl border border-gray-200 shadow-sm p-8">
            <h3 class="font-bold text-brand-black text-xl mb-3">{value.heading}</h3>
            <p class="text-gray-600 leading-relaxed">{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Location and contact -->
  <section class="bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <h2 class="font-display font-bold text-brand-black text-3xl lg:text-4xl mb-10">Find Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Address</h3>
            <address class="not-italic text-gray-600 leading-relaxed">
              24831 Jefferson Ave Ste. 104<br />
              Murrieta, CA 92562
            </address>
          </div>
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Email</h3>
            <a href="mailto:VXN.polefitness@gmail.com" class="text-brand-black font-medium hover:underline">
              VXN.polefitness@gmail.com
            </a>
          </div>
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Instagram</h3>
            <a
              href="https://instagram.com/vixen_pole_fitness_"
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-black font-medium hover:underline"
            >
              @vixen_pole_fitness_
            </a>
          </div>
        </div>
        <div class="flex flex-col gap-4">
          <a
            href="/contact"
            class="inline-flex items-center px-6 py-3 bg-brand-black text-brand-white text-sm font-semibold rounded-lg hover:bg-gray-800 transition-colors self-start"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { banner } from "../data/content.ts";
import { instructors as allInstructors } from "../data/instructors.ts";
import heroImage from "../assets/images/gallery/gallery-6.jpeg";

const featuredClasses = [
  {
    name: "Beginner Pole Fitness",
    description: "Learn foundational tricks and spins in a supportive setting. No experience required.",
  },
  {
    name: "Heels Choreography",
    description: "Dance, flow, and perform in heels. All levels welcome — beginners included.",
  },
  {
    name: "Pole Prep",
    description: "Conditioning and strength training built specifically to support your pole journey.",
  },
];

const instructors = allInstructors.filter((i) => i.isOwner);

---

<BaseLayout
  title="Vixen Pole Fitness | Pole Fitness for All Bodies in Murrieta, CA"
  description="A welcoming, non-judgmental pole fitness studio in Murrieta, CA. All levels welcome. Book a class today."
>
  <!-- Banner — only renders when banner.active is true -->
  {banner.active && (
    <div class="w-full bg-brand-mint text-brand-black text-center py-3 px-4 text-sm font-medium">
      {banner.link ? (
        <a href={banner.link} class="underline hover:no-underline">
          {banner.text}{banner.linkText ? ` — ${banner.linkText}` : ""}
        </a>
      ) : (
        <span>{banner.text}</span>
      )}
    </div>
  )}

  <!-- Hero -->
  <section class="relative bg-brand-black overflow-hidden min-h-[65vh] flex items-end">
    <!-- Background photo anchored right, fading left -->
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt=""
        aria-hidden="true"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-contain object-right opacity-25"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to right, #1A1A1A 50%, transparent 90%)"></div>
    </div>
    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 lg:pt-28 lg:pb-32 w-full">
      <p class="text-brand-mint text-xs font-semibold uppercase tracking-[0.2em] mb-8">
        Murrieta, CA
      </p>
      <h1 class="font-display font-bold text-brand-white leading-none mb-6 text-[clamp(3.5rem,10vw,8rem)]">
        Pole Fitness,<br>For All Bodies.
      </h1>
      <p class="text-brand-mint text-xl font-semibold mb-10">Discover your inner Vixen.</p>
      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="/classes"
          class="inline-flex items-center px-6 py-3 bg-brand-mint text-brand-black text-sm font-semibold rounded-lg hover:bg-brand-mint-dark transition-colors"
        >
          Book a Class
        </a>
        <a
          href="/classes"
          class="inline-flex items-center px-6 py-3 border border-gray-700 text-brand-white text-sm font-semibold rounded-lg hover:border-brand-mint hover:text-brand-mint transition-colors"
        >
          See Our Classes
        </a>
      </div>
    </div>
  </section>

  <!-- Value prop — asymmetric breakout -->
  <section class="bg-brand-white">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[60vh]">
      <!-- Left: full-bleed studio photo -->
      <div class="relative bg-brand-black min-h-72 lg:min-h-0 overflow-hidden">
        <img
          src="/images/gallery/photo-extra.jpg"
          alt="Vixen Pole Fitness studio"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute top-0 left-0 w-16 h-1 bg-brand-mint"></div>
      </div>
      <!-- Right: text -->
      <div class="px-8 py-16 lg:px-16 lg:py-24 flex flex-col justify-center">
        <p class="text-brand-mint-deep text-xs font-bold uppercase tracking-[0.2em] mb-5">Why Vixen</p>
        <h2 class="font-display font-bold text-brand-black leading-tight mb-6 text-4xl lg:text-5xl">
          All Levels.<br>All Bodies.<br>No Judgment.
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          We built this studio because pole fitness should be accessible to everyone. No prerequisites, no intimidating atmosphere — just movement, community, and progression at your own pace.
        </p>
        <p class="text-gray-600 leading-relaxed mb-10">
          Whether you've never set foot in a studio or you're looking to push your technique further, you belong here.
        </p>
        <a
          href="/about"
          class="inline-flex items-center text-sm font-semibold text-brand-black underline underline-offset-4 hover:no-underline self-start"
        >
          Our Story →
        </a>
      </div>
    </div>
  </section>

  <!-- Classes — light section with numbered cards -->
  <section class="bg-brand-gray py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <h2 class="font-display font-bold text-brand-black text-5xl lg:text-6xl leading-none">Classes</h2>
        <a href="/classes" class="text-sm font-semibold text-gray-600 hover:text-brand-black transition-colors">
          View All →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredClasses.map((cls, i) => (
          <a
            href="/classes"
            class="group block bg-brand-white border border-gray-200 rounded-xl p-8 hover:border-brand-mint transition-colors duration-200 shadow-sm"
          >
            <p class="text-brand-mint-deep font-bold text-xl font-display mb-3">0{i + 1}</p>
            <div class="h-px bg-brand-mint w-8 mb-6 group-hover:w-16 transition-all duration-300"></div>
            <h3 class="font-bold text-brand-black text-xl mb-3">{cls.name}</h3>
            <p class="text-gray-500 leading-relaxed text-sm mb-8">{cls.description}</p>
            <span class="text-brand-mint-deep text-sm font-semibold">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Instructors — dark editorial cards -->
  <section class="bg-brand-black py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-brand-white text-5xl lg:text-6xl leading-none mb-12">
        Meet Your Instructors
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        {instructors.map((instructor) => (
          <div class="relative rounded-xl overflow-hidden aspect-[3/4] md:aspect-[4/3] flex items-end">
            <img
              src={instructor.photo}
              alt={instructor.name}
              class="absolute inset-0 w-full h-full object-cover"
              style={`object-position: ${instructor.photoPosition}`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="relative z-10 p-8">
              <div class="h-px bg-brand-mint w-8 mb-4"></div>
              <h3 class="font-display font-bold text-brand-white text-2xl mb-1">{instructor.name}</h3>
              <p class="text-brand-mint text-xs font-semibold uppercase tracking-wider mb-3">{instructor.role}</p>
              <p class="text-gray-300 leading-relaxed text-sm">{instructor.bio}</p>
            </div>
          </div>
        ))}
      </div>
      <a
        href="/instructors"
        class="text-sm font-semibold text-gray-400 hover:text-brand-mint transition-colors underline underline-offset-4 hover:no-underline"
      >
        Meet the Full Team →
      </a>
    </div>
  </section>

  <!-- CTA strip — mint bg -->
  <section class="bg-brand-mint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <h2 class="font-display font-bold text-brand-black leading-tight mb-6 text-5xl lg:text-7xl">
        Your first class<br>is the hardest<br>part.
      </h2>
      <p class="text-gray-700 text-xl leading-relaxed mb-10 max-w-md">
        We make the rest easy.
      </p>
      <a
        href="/classes"
        class="inline-flex items-center px-8 py-4 bg-brand-black text-brand-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors"
      >
        Book a Class
      </a>
    </div>
  </section>
</BaseLayout>

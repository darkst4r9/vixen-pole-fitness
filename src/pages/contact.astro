---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Vixen Pole Fitness"
  description="Contact Vixen Pole Fitness in Murrieta, CA. Questions about pole fitness classes, pricing, or scheduling? We're happy to help."
>
  <!-- Hero -->
  <section class="relative bg-brand-black overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.12]"
      style="background-image: url('/images/brand/bg-texture.jpg'); background-size: cover; background-position: center;"
    ></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <p class="text-brand-mint text-xs font-semibold uppercase tracking-[0.2em] mb-6">Murrieta, CA</p>
      <h1 class="font-display font-bold text-brand-white leading-none mb-6 text-[clamp(3rem,8vw,6rem)]">
        Get in Touch
      </h1>
      <p class="text-gray-400 text-lg leading-relaxed max-w-xl">
        Questions about classes, pricing, or what to expect? We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Two-column: contact CTA + info -->
  <section class="bg-brand-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Email CTA card -->
        <div class="bg-brand-white rounded-xl border border-gray-200 shadow-sm p-8 flex flex-col justify-between">
          <div>
            <h2 class="font-display font-bold text-brand-black text-3xl mb-4">Send Us an Email</h2>
            <p class="text-gray-600 leading-relaxed mb-8">
              Drop us a line with any questions about classes, pricing, or what to expect your first time in. We typically respond within 24 hours.
            </p>
          </div>
          <div>
            <a
              href="mailto:VXN.polefitness@gmail.com"
              class="inline-flex items-center px-6 py-3 bg-brand-black text-brand-white text-sm font-semibold rounded-lg hover:bg-gray-800 transition-colors"
            >
              VXN.polefitness@gmail.com
            </a>
            <p class="text-xs text-gray-400 mt-4">Opens your email client.</p>
          </div>
        </div>

        <!-- Contact info + map -->
        <div class="flex flex-col gap-10">
          <div class="space-y-8">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Address</h3>
              <address class="not-italic text-gray-700 leading-relaxed">
                24831 Jefferson Ave Ste. 104<br />
                Murrieta, CA 92562
              </address>
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Email</h3>
              <a
                href="mailto:VXN.polefitness@gmail.com"
                class="text-brand-black font-medium hover:underline"
              >
                VXN.polefitness@gmail.com
              </a>
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Instagram</h3>
              <a
                href="https://instagram.com/vixen_pole_fitness_"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-black font-medium hover:underline"
              >
                @vixen_pole_fitness_
              </a>
            </div>
          </div>

          <!-- Google Maps embed -->
          <div class="rounded-xl overflow-hidden border border-gray-200 shadow-sm">
            <iframe
              src="https://maps.google.com/maps?q=24831+Jefferson+Ave+Ste+104,+Murrieta,+CA+92562&hl=en&z=15&output=embed"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Vixen Pole Fitness location on Google Maps"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

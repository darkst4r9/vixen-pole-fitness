---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formspreeEndpoint } from "../data/content.ts";
---

<BaseLayout
  title="Contact | Vixen Pole Fitness"
  description="Contact Vixen Pole Fitness in Murrieta, CA. Questions about pole fitness classes, pricing, or scheduling? We're happy to help."
>
  <!-- Hero -->
  <section class="bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-bold text-brand-black mb-6">
          Get in Touch
        </h1>
        <p class="text-gray-600 text-xl leading-relaxed">
          Questions about classes, pricing, or what to expect? We'd love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <!-- Two-column: form + contact info -->
  <section class="bg-brand-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Contact form -->
        <div class="bg-brand-white rounded-xl border border-gray-200 shadow-sm p-8">
          <h2 class="text-2xl font-bold text-brand-black mb-6">Send a Message</h2>
          <form method="POST" action={formspreeEndpoint} class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-brand-black placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-mint focus:border-transparent"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="_replyto"
                required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-brand-black placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-mint focus:border-transparent"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">
                Subject
              </label>
              <input
                type="text"
                id="subject"
                name="_subject"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-brand-black placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-mint focus:border-transparent"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-brand-black placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-mint focus:border-transparent resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-brand-black text-brand-white px-6 py-3 rounded-lg text-sm font-semibold hover:bg-gray-800 transition-colors"
            >
              Send Message
            </button>

            <p class="text-xs text-gray-500">We typically respond within 24 hours.</p>
          </form>
        </div>

        <!-- Contact info -->
        <div class="flex flex-col gap-10">
          <div class="space-y-8">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Address</h3>
              <address class="not-italic text-gray-700 leading-relaxed">
                24831 Jefferson Ave Ste. 104<br />
                Murrieta, CA 92562
              </address>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Email</h3>
              <a
                href="mailto:VXN.polefitness@gmail.com"
                class="text-brand-black font-medium hover:underline"
              >
                VXN.polefitness@gmail.com
              </a>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Instagram</h3>
              <a
                href="https://instagram.com/vixen_pole_fitness_"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-black font-medium hover:underline"
              >
                @vixen_pole_fitness_
              </a>
            </div>
          </div>

          <!-- Google Maps embed -->
          <div class="rounded-xl overflow-hidden border border-gray-200 shadow-sm">
            <iframe
              src="https://maps.google.com/maps?q=24831+Jefferson+Ave+Ste+104,+Murrieta,+CA+92562&hl=en&z=15&output=embed"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Vixen Pole Fitness location on Google Maps"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
